{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{skills,reports,lib,config,contracts,scripts}/**"
    }
  },
  "rewrites": [
    {
      "source": "/x402/:path*",
      "destination": "/api/x402?scope=resource&path=:path*"
    },
    {
      "source": "/x402-facilitator/:path*",
      "destination": "/api/x402?scope=facilitator&path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/run?slug=weekly-digest-agent&cron=1",
      "schedule": "0 8 * * 1"
    }
  ]
}
